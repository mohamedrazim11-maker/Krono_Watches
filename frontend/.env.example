# PayHere sandbox credentials from your PayHere merchant dashboard.
# Never commit the matching .env.local file.
PAYHERE_MERCHANT_ID=1238121
PAYHERE_MERCHANT_SECRET=replace_with_your_sandbox_merchant_secret

# Public HTTPS base URL for PayHere return, cancel, and notification callbacks.
# For real callback delivery during local testing, use a public HTTPS tunnel URL.
NEXT_PUBLIC_APP_URL=https://your-public-https-url.example

# Administrator Credentials (Admin Dashboard / Atelier Director)
ADMIN_EMAIL=admin@krono.luxury
ADMIN_PASSWORD=Admin@1234
